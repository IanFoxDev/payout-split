{
    "name": "ianfoxdev/payout-split",
    "description": "Splits a pool of money between partners by weights: the shares always add up to the pool, and recalculating a closed period gives the same result.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "money",
        "payouts",
        "revenue-share",
        "allocation",
        "largest-remainder",
        "affiliates",
        "royalties",
        "fintech"
    ],
    "homepage": "https://github.com/IanFoxDev/payout-split",
    "authors": [
        {
            "name": "Anatoly Pankratyev",
            "email": "ianfoxdeveloper@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/IanFoxDev/payout-split/issues",
        "source": "https://github.com/IanFoxDev/payout-split"
    },
    "require": {
        "php": "^8.3",
        "brick/math": "^0.12 || ^0.13 || ^0.14 || ^0.15 || ^0.16 || ^0.17 || ^0.18 || ^0.19 || ^0.20 || ^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "IanFoxDev\\PayoutSplit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IanFoxDev\\PayoutSplit\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
